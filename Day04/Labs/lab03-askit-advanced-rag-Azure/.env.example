# AWS Bedrock is the MAIN provider. The AWS keys and BEDROCK_SMALL_MODEL_ID come from the course .env
# in the Participants folder (the trainer shares it). Nothing to add here for Bedrock.

# OPTIONAL backup: an OpenAI key (you can also paste it in the app sidebar)
OPENAI_API_KEY=

# OPTIONAL: Azure AI Foundry OpenAI-compatible model inference endpoint.
# Use the endpoint URL shown for your Foundry deployment (commonly ending in /models).
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_ENDPOINT=
# Set these to the chat and embedding model/deployment names available at that endpoint.
AZURE_AI_FOUNDRY_CHAT_MODEL=gpt-4o-mini
AZURE_AI_FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small
